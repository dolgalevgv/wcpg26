manifest {
    name = 'wcpg2026'
    description = 'eQTL analysis of coculture data with SAIGE-QTL'
    nextflowVersion = '>=25.10.0'
}

params {
    vcf = null
    donors = null
    source_fasta = null
    target_fasta = null
    chain_file = null
    ld_exclude_bed = null
    n_pcs = 3
    outdir = 'results'
    help = false
}

process {
    errorStrategy = 'terminate'
    maxForks = 4
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    slurm {
        process {
            executor = 'slurm'
            queue = 'normal'

            // Initial resource requests; tune using the execution reports.
            cpus = 1
            memory = '8 GB'
            time = '24h'

            withName: PREPARE_DONORS {
                memory = '1 GB'
                time = '1h'
            }
            withName: 'PLINK_.*' {
                cpus = 4
            }
        }
    }
}
trace {
    enabled = !params.help
    file = "${params.outdir}/execution/trace.tsv"
    overwrite = true
}
report {
    enabled = !params.help
    file = "${params.outdir}/execution/report.html"
    overwrite = true
}
timeline {
    enabled = !params.help
    file = "${params.outdir}/execution/timeline.html"
    overwrite = true
}
